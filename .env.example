# Cloudflare WorkerのエンドポイントURL
EXPO_PUBLIC_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# 送迎通知専用LINE公式アカウントの「友だち追加」URL（LINE Official Account Managerで発行）
# 全施設で共通の1アカウントのため、施設ごとではなくアプリ全体で1つだけ設定する。
EXPO_PUBLIC_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@your-line-id

# ご家族のLINE連携ページ（Workerの /link）用のLIFF ID。設定すると、招待コード画面のQRを
# 1回読むだけで友だち追加と連携が完了する。未設定なら従来の「友だち追加→コード送信」表示。
EXPO_PUBLIC_LINE_LINK_LIFF_ID=

# 施設のAPIキー（Supabase の facilities.api_key）はここでは設定しない。
# アプリ初回起動時のセットアップ画面で入力し、端末側に保存する仕組みになっている。
